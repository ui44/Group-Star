<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- WebView — full screen -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Right-side tab buttons (always visible) -->
    <LinearLayout
        android:id="@+id/tabButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:orientation="vertical"
        android:layout_marginEnd="0dp">

        <!-- CORD button -->
        <LinearLayout
            android:id="@+id/btnCordTab"
            android:layout_width="32dp"
            android:layout_height="72dp"
            android:background="@drawable/tab_arrow_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/arrowCord"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_tab"
                android:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- NUKER button -->
        <LinearLayout
            android:id="@+id/btnNukerTab"
            android:layout_width="32dp"
            android:layout_height="72dp"
            android:background="@drawable/tab_nuker_bg"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_skull"
                android:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- CORD Side Panel -->
    <LinearLayout
        android:id="@+id/cordPanel"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/side_panel_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:translationX="240dp"
        android:visibility="visible"
        android:elevation="12dp">

        <!-- Panel header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ CORD"
            android:textColor="#7C3AED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#7C3AED"
            android:layout_marginBottom="8dp"/>

        <!-- Fake Deafen Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎧 Fake Deafen"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <Switch
                android:id="@+id/switchFakeDeafen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="#7C3AED"
                android:trackTint="#3D1F8C"/>
        </LinearLayout>

        <!-- Desktop Spoof Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖥️ Desktop Spoof"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <Switch
                android:id="@+id/switchDesktopSpoof"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#7C3AED"
                android:trackTint="#3D1F8C"/>
        </LinearLayout>

        <!-- Vencord Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ Vencord"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <Switch
                android:id="@+id/switchVencord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#7C3AED"
                android:trackTint="#3D1F8C"/>
        </LinearLayout>

        <!-- Arabic Language Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌐 Arabic Lang"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <Switch
                android:id="@+id/switchArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="#7C3AED"
                android:trackTint="#3D1F8C"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A3E"
            android:layout_marginBottom="8dp"/>

        <!-- Theme label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎨 Theme"
            android:textColor="#AAAACC"
            android:textSize="11sp"
            android:layout_marginBottom="4dp"/>

        <!-- Theme selector -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/themeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/themeDefault"
                    android:layout_width="52dp" android:layout_height="28dp"
                    android:text="Default" android:textColor="#FFFFFF"
                    android:textSize="9sp" android:gravity="center"
                    android:background="#5865F2" android:layout_marginEnd="4dp"/>

                <TextView android:id="@+id/themeOneDark"
                    android:layout_width="52dp" android:layout_height="28dp"
                    android:text="OneDark" android:textColor="#FFFFFF"
                    android:textSize="9sp" android:gravity="center"
                    android:background="#282C34" android:layout_marginEnd="4dp"/>

                <TextView android:id="@+id/themeMidnight"
                    android:layout_width="52dp" android:layout_height="28dp"
                    android:text="Midnight" android:textColor="#FFFFFF"
                    android:textSize="9sp" android:gravity="center"
                    android:background="#0D0D0D" android:layout_marginEnd="4dp"/>

                <TextView android:id="@+id/themePurple"
                    android:layout_width="52dp" android:layout_height="28dp"
                    android:text="Purple" android:textColor="#FFFFFF"
                    android:textSize="9sp" android:gravity="center"
                    android:background="#7C3AED"/>
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A3E"
            android:layout_marginBottom="8dp"/>

        <!-- Accounts label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Accounts"
            android:textColor="#AAAACC"
            android:textSize="11sp"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnManageAccounts"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="Manage Accounts"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="#3D1F8C"
            android:layout_marginBottom="8dp"/>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    </LinearLayout>

</FrameLayout>
